{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run ICP-Flow GPU demo",
      "type": "process",
      "command": "/home/ubuntu/miniforge3/envs/icp_flow/bin/python",
      "args": [
        "scripts/demo_remote.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CUDA_HOME": "/home/ubuntu/miniforge3/envs/icp_flow",
          "LIBRARY_PATH": "/home/ubuntu/miniforge3/envs/icp_flow/lib",
          "MAX_JOBS": "4",
          "MPLBACKEND": "Agg"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Preview ICP-Flow results",
      "type": "process",
      "command": "/home/ubuntu/miniforge3/envs/icp_flow/bin/python",
      "args": [
        "-u",
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "results"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
